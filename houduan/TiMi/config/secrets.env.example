# 千万次（TiMi）- 密钥文件模板（**可提交**，不含真实密钥）
#
# 用法：
#   1) 复制为 `secrets.local.env`（**已被 .gitignore 忽略**，不会进仓库）
#   2) 填入真实值（或由 scripts/export-secrets.ps1 从现有 yml 自动导出）
#   3) 起服务前把它注入环境变量：
#        Windows 本地：start-local.bat 会自动读取 config\secrets.local.env
#        生产 systemd：EnvironmentFile=/opt/qianwanci/config/secrets.env（见 千万次-生产部署清单.md §6）
#
# 变量名必须与 yml 里 `privateKeyEnv` / `HotWalletKeyEnv` 的值一致，改一处要改两处。
# yml 里对应的 `Private:` / `EvmPrivate:` / `HotWalletPrivate:` 字段应留空。

# KTO 资金池私钥（yml: KtoPool.privateKeyEnv）
KTO_POOL_PRIVATE_KEY=

# TRON 资金池私钥（yml: TronPool.privateKeyEnv）
TRON_POOL_PRIVATE_KEY=

# 手续费销毁出资私钥（yml: Burn.privateKeyEnv；该地址需持有手续费币种 TM）
BURN_EVM_PRIVATE_KEY=

# 出金热钱包私钥（yml: Withdraw.HotWalletKeyEnv）
HOT_WALLET_PRIVATE_KEY=

# 用户私钥落库加密口令（AES，16/24/32 位；见 utils/ase.go）
# ⚠ 不要随意更换：库内既有 wallet.sign 是用旧口令加密的，换了就解不开（需先做重加密迁移）。
NPOWER_AES_SECRET_KEY=

# 以下不是私钥，但同样是"不该进仓库"的凭据（当前 yml 里是明文，生产请改为环境变量/密钥管理）：
#   - MySQL 口令（Mysql.Dns 里的 root 密码）
#   - Redis requirepass
#   - JWT 签名 secretKey（换了之后所有已发出的会话票失效，用户需重新签名登录）
#   - ops 运维后台口令（Ops.Password）
#   - KTO/TRON 节点 ApiKey（第三方服务的 key，泄漏后可被刷额度）
