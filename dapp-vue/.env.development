# 千万次 DApp 本地开发环境变量
# 指向本地后端（npower 主服务 :3000，含 /api 适配层）
# 生产环境部署时改为后端 API 域名并去掉本文件或改值
VITE_API_BASE=http://127.0.0.1:3000
# /api 鉴权密钥（与后端 yml apiAuthKey 配对；本地后端未设则留空）
VITE_API_KEY=privchain-apikey

# ==================== 链参数（默认 FIBONACCI 主网，此处改成本地私链） ====================
# ⚠ 不配这些也能跑：constants/config.js 会回落到主网 12306 / network.hzroc.art。
#   但连接钱包时前端会**强制**把用户钱包切到配置的链，所以私链联调必须在这里改，
#   否则钱包会被推去主网、DApp 根本连不上（见 services/wallet.js#ensureChain）。
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=FIBONACCI 私链
VITE_CHAIN_RPC=http://127.0.0.1:8545
# 私链没有区块浏览器：留空即不带 blockExplorerUrls（空串会被钱包判为非法参数）
VITE_CHAIN_EXPLORER=
VITE_CHAIN_NATIVE=FIBO
VITE_CHAIN_DECIMALS=18
