# 千万次 DApp - 环境变量模板（复制为 .env.development / .env.production 后填写）
#
# Vite 规则：只有 VITE_ 前缀的变量会注入前端；注入是**构建期**行为，
# 改完必须重新 build（或重启 dev server）才生效。
# 各变量的默认值见 src/constants/config.js。

# ==================== 后端接口 ====================

# /api 适配层基地址（必填）。
# 未填写 / 仍是占位符（含 < > 或 example.com）时：
#   - 页面顶部显示「未配置后端接口地址」阻塞横幅
#   - 所有 /api 请求直接失败并给出可操作的原因（不会静默打到假域名）
VITE_API_BASE=https://api.your-domain.com

# /api 请求头 X-API-Key，与后端 yml apiAuthKey 配对。后端未开启时留空。
# ⚠ 会被打进前端产物，任何人都能在浏览器里看到 —— 它不是用来保护用户资产的秘密，
#   真正的鉴权是钱包签名会话（Authorization: Bearer）。生产请通过 CI/部署平台 secrets 注入。
VITE_API_KEY=

# ==================== 演示数据（默认关闭） ====================

# true = 允许读接口在后端不可用时回落到本地模拟数据（localStorage），界面顶部常驻
#        「演示数据（未连接后端）」横幅。
# false/缺省 = 关闭：任何失败都原样抛错，绝不返回编造数据。
# ⚠ 写接口（参投 / 提现 / 领取产出 / 切换算力模式）无论此值如何都**永不** mock。
VITE_ENABLE_MOCK=false

# ==================== 链参数（默认 FIBONACCI 主网） ====================

# 连接钱包时前端会强制把用户钱包切到这条链（services/wallet.js#ensureChain），
# 私链 / 测试网联调必须改这里，否则钱包会被推去主网、DApp 连不上。
VITE_CHAIN_ID=12306
VITE_CHAIN_NAME=FIBONACCI
VITE_CHAIN_RPC=https://network.hzroc.art
# 没有区块浏览器的私链请留空（空串会被钱包判为非法参数，代码里会自动不带该字段）
VITE_CHAIN_EXPLORER=https://hzroc.art
VITE_CHAIN_NATIVE=FIBO
VITE_CHAIN_DECIMALS=18

# ==================== "获取 TM" 入口（可选） ====================

# TM 是提现手续费币种（3%）与算力模式 2 的兑换币种。填了这里，提币页会显示"获取 TM"按钮
# （新窗口打开）；留空则整块隐藏。通常填 DEX/CEX 的 TM 交易对链接，例如：
#   https://app.uniswap.org/#/swap?outputCurrency=0x...
# 必须是以 http(s):// 开头的完整链接，否则视为未配置（不给假链接）。
VITE_BUY_TM_URL=